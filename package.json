{
  "name": "patternholic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init:local": "wrangler d1 execute patternholic-db --local --file=./migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 migrations apply patternholic-db --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "hono": "^4.6.0",
    "osu-pp": "^0.1.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241101.0",
    "@types/node": "^26.6.5",
    "@vercel/node": "^27.0.2",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0",
    "wrangler": "^3.80.0"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "workerd": true
  }
}
