{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["vite.config.ts", "worker/**/*.ts", "server/**/*.ts", "api/**/*.ts"]
}
